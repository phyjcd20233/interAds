<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>美國國債計算器 | U.S. Treasury Bond Calculator</title>
  <script src="https://cdn.jsdelivr.net/npm/react@18.2.0/umd/react.production.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/react-dom@18.2.0/umd/react-dom.production.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/babel-standalone@6.26.0/babel.min.js"></script>
  <style>
    /* Minimal Tailwind CSS output for required classes */
    .bg-gray-100 { background-color: #f3f4f6; }
    .min-h-screen { min-height: 100vh; }
    .flex { display: flex; }
    .items-center { align-items: center; }
    .justify-center { justify-content: center; }
    .max-w-4xl { max-width: 42rem; }
    .mx-auto { margin-left: auto; margin-right: auto; }
    .p-6 { padding: 1.5rem; }
    .bg-white { background-color: #ffffff; }
    .rounded-lg { border-radius: 0.5rem; }
    .shadow-lg { box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05); }
    .text-2xl { font-size: 1.5rem; line-height: 2rem; }
    .font-bold { font-weight: 700; }
    .text-center { text-align: center; }
    .mb-6 { margin-bottom: 1.5rem; }
    .grid { display: grid; }
    .grid-cols-1 { grid-template-columns: repeat(1, minmax(0, 1fr)); }
    .md\\:grid-cols-2 { @media (min-width: 768px) { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    .gap-4 { gap: 1rem; }
    .block { display: block; }
    .text-sm { font-size: 0.875rem; line-height: 1.25rem; }
    .font-medium { font-weight: 500; }
    .text-gray-700 { color: #374151; }
    .mt-1 { margin-top: 0.25rem; }
    .w-full { width: 100%; }
    .p-2 { padding: 0.5rem; }
    .border { border-width: 1px; border-color: #e5e7eb; }
    .rounded-md { border-radius: 0.375rem; }
    .text-gray-600 { color: #4b5563; }
    .text-red-500 { color: #ef4444; }
    .mt-4 { margin-bottom: 1rem; }
    .space-x-4 > :not(:last-child) { margin-right: 1rem; }
    .bg-blue-500 { background-color: #3b82f6; }
    .text-white { color: #ffffff; }
    .px-4 { padding-left: 1rem; padding-right: 1rem; }
    .py-2 { padding-top: 0.5rem; padding-bottom: 0.5rem; }
    .hover\\:bg-blue-600:hover { background-color: #2563eb; }
    .bg-green-500 { background-color: #22c55e; }
    .hover\\:bg-green-600:hover { background-color: #16a34a; }
    .bg-gray-50 { background-color: #f9fafb; }
    .text-lg { font-size: 1.125rem; line-height: 1.75rem; }
    .font-semibold { font-weight: 600; }
    .list-disc { list-style-type: disc; }
    .pl-5 { padding-left: 1.25rem; }
    .bg-red-500 { background-color: #ef4444; }
    .hover\\:bg-red-600:hover { background-color: #dc2626; }
    .space-y-2 > :not(:last-child) { margin-bottom: 0.5rem; }
    .p-4 { padding: 1rem; }
    .shadow { box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06); }
    .mb-4 { margin-bottom: 1rem; }
  </style>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center">
  <div id="root"></div>
  <script type="text/babel">
    const { useState, useEffect } = React;

    // 模擬 CUSIP 數據庫
    const cusipData = {
      '91282CLW9': {
        issueDate: '2024-11-15',
        maturityDate: '2034-11-15',
        couponRate: 4.25,
        paymentDates: ['05-15', '11-15'] // 每年5月15日和11月15日付息
      }
    };

    // 語言翻譯對象
    const translations = {
      zh: {
        title: '美國國債計算器',
        cusip: 'CUSIP 編號',
        buyPrice: '買入價格（每100美元面值）',
        buyDate: '買入日期',
        investmentAmount: '投資金額（美元）',
        couponRate: '票面利率（%）',
        sellDate: '賣出日期',
        sellPrice: '賣出價格（每100美元面值）',
        calculate: '計算',
        exportCSV: '匯出 CSV',
        clearHistory: '清除歷史記錄',
        results: '計算結果',
        faceValue: '面值',
        accruedInterest: '應計利息',
        netInterest: '淨利息收入',
        capitalGain: '資本利得',
        totalReturn: '總回報',
        returnPercentage: '回報百分比',
        calculationSteps: '計算步驟',
        history: '歷史記錄',
        date: '日期',
        invalidCusip: '無效的 CUSIP 編號',
        fillAllFields: '請填寫所有欄位',
        invalidNumbers: '請輸入有效的價格、投資金額和票面利率',
        invalidDateFormat: '無效的日期格式',
        sellDateAfterBuy: '賣出日期必須晚於買入日期',
        taxNote: '提示：利息收入需繳美國聯邦所得稅，香港無本地稅。請諮詢稅務顧問。',
        exchangeRate: '美元兌港元匯率（可選）',
        hkdReturn: '港元回報（估算）',
        language: 'English'
      },
      en: {
        title: 'U.S. Treasury Bond Calculator',
        cusip: 'CUSIP Number',
        buyPrice: 'Buy Price (per $100 face value)',
        buyDate: 'Buy Date',
        investmentAmount: 'Investment Amount (USD)',
        couponRate: 'Coupon Rate (%)',
        sellDate: 'Sell Date',
        sellPrice: 'Sell Price (per $100 face value)',
        calculate: 'Calculate',
        exportCSV: 'Export to CSV',
        clearHistory: 'Clear History',
        results: 'Results',
        faceValue: 'Face Value',
        accruedInterest: 'Accrued Interest',
        netInterest: 'Net Interest Income',
        capitalGain: 'Capital Gain',
        totalReturn: 'Total Return',
        returnPercentage: 'Return Percentage',
        calculationSteps: 'Calculation Steps',
        history: 'Calculation History',
        date: 'Date',
        invalidCusip: 'Invalid CUSIP number',
        fillAllFields: 'Please fill in all fields',
        invalidNumbers: 'Please enter valid numbers for prices, investment amount, and coupon rate',
        invalidDateFormat: 'Invalid date format',
        sellDateAfterBuy: 'Sell date must be after buy date',
        taxNote: 'Note: Interest income is subject to U.S. federal income tax; no local tax in Hong Kong. Consult a tax advisor.',
        exchangeRate: 'USD/HKD Exchange Rate (optional)',
        hkdReturn: 'HKD Return (estimated)',
        language: '繁體中文'
      }
    };

    // 日期計算輔助函數
    const differenceInDays = (date1, date2) => {
      const oneDay = 24 * 60 * 60 * 1000;
      return Math.round(Math.abs((date1 - date2) / oneDay));
    };

    const formatDate = (date) => {
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const day = String(date.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    };

    const BondCalculator = () => {
      // 狀態管理
      const [language, setLanguage] = useState('zh');
      const [cusip, setCusip] = useState('91282CLW9');
      const [buyPrice, setBuyPrice] = useState('');
      const [buyDate, setBuyDate] = useState('');
      const [investmentAmount, setInvestmentAmount] = useState('');
      const [couponRate, setCouponRate] = useState('');
      const [sellDate, setSellDate] = useState('');
      const [sellPrice, setSellPrice] = useState('');
      const [exchangeRate, setExchangeRate] = useState('');
      const [results, setResults] = useState(null);
      const [error, setError] = useState('');
      const [history, setHistory] = useState(JSON.parse(localStorage.getItem('calcHistory')) || []);

      // 語言切換
      const toggleLanguage = () => {
        setLanguage(language === 'zh' ? 'en' : 'zh');
      };

      // 自動填充 CUSIP 相關數據
      useEffect(() => {
        if (cusipData[cusip]) {
          setCouponRate(cusipData[cusip].couponRate.toString());
        } else {
          setCouponRate('');
        }
      }, [cusip]);

      // 計算應計利息、淨利息和資本利得
      const calculateReturns = () => {
        setError('');
        setResults(null);

        // 輸入驗證
        try {
          if (!cusipData[cusip]) {
            throw new Error(translations[language].invalidCusip);
          }
          if (!buyPrice || !buyDate || !investmentAmount || !couponRate || !sellDate || !sellPrice) {
            throw new Error(translations[language].fillAllFields);
          }
          const buyPriceNum = parseFloat(buyPrice);
          const investmentAmountNum = parseFloat(investmentAmount);
          const couponRateNum = parseFloat(couponRate);
          const sellPriceNum = parseFloat(sellPrice);
          const exchangeRateNum = exchangeRate ? parseFloat(exchangeRate) : null;
          if (isNaN(buyPriceNum) || isNaN(investmentAmountNum) || isNaN(couponRateNum) || isNaN(sellPriceNum) || (exchangeRate && isNaN(exchangeRateNum))) {
            throw new Error(translations[language].invalidNumbers);
          }
          const buyDateObj = new Date(buyDate);
          const sellDateObj = new Date(sellDate);
          if (isNaN(buyDateObj) || isNaN(sellDateObj)) {
            throw new Error(translations[language].invalidDateFormat);
          }
          if (buyDateObj >= sellDateObj) {
            throw new Error(translations[language].sellDateAfterBuy);
          }

          // 計算面值
          const faceValue = investmentAmountNum / (buyPriceNum / 100);
          console.log('Face Value:', faceValue); // 調試日誌

          // 計算應計利息
          const lastPaymentDate = getLastPaymentDate(buyDateObj, cusipData[cusip].paymentDates);
          const daysAccrued = differenceInDays(buyDateObj, lastPaymentDate);
          const semiAnnualCoupon = (couponRateNum / 100) * faceValue / 2;
          const accruedInterest = (semiAnnualCoupon / 180) * daysAccrued;
          console.log('Accrued Interest:', accruedInterest, 'Days:', daysAccrued); // 調試日誌

          // 計算收到的利息支付
          const paymentDates = getPaymentDatesBetween(buyDateObj, sellDateObj, cusipData[cusip].paymentDates);
          const totalInterestReceived = semiAnnualCoupon * paymentDates.length;
          console.log('Payment Dates:', paymentDates, 'Total Interest:', totalInterestReceived); // 調試日誌

          // 淨利息收入
          const netInterest = totalInterestReceived - accruedInterest;

          // 計算資本利得
          const capitalGain = (sellPriceNum - buyPriceNum) * (faceValue / 100);

          // 總回報
          const totalReturn = netInterest + capitalGain;
          const returnPercentage = (totalReturn / investmentAmountNum) * 100;
          const hkdReturn = exchangeRateNum ? (totalReturn * exchangeRateNum).toFixed(2) : null;

          // 計算步驟（根據語言動態生成）
          const steps = [
            `1. ${language === 'zh' ? '面值 = 投資金額 ÷ (買入價格 ÷ 100)' : 'Face Value = Investment Amount ÷ (Buy Price ÷ 100)'} = ${investmentAmountNum} ÷ (${buyPriceNum} ÷ 100) = ${faceValue.toFixed(2)} USD`,
            `2. ${language === 'zh' ? '半年票息 = (票面利率 ÷ 100) × 面值 ÷ 2' : 'Semi-Annual Coupon = (Coupon Rate ÷ 100) × Face Value ÷ 2'} = (${couponRateNum} ÷ 100) × ${faceValue.toFixed(2)} ÷ 2 = ${semiAnnualCoupon.toFixed(2)} USD`,
            `3. ${language === 'zh' ? '應計利息天數 = 從' : 'Accrued Interest Days = Days from'} ${formatDate(lastPaymentDate)} ${language === 'zh' ? '到' : 'to'} ${buyDate} = ${daysAccrued} ${language === 'zh' ? '天' : 'days'}`,
            `4. ${language === 'zh' ? '應計利息 = (半年票息 ÷ 180) × 應計天數' : 'Accrued Interest = (Semi-Annual Coupon ÷ 180) × Accrued Days'} = (${semiAnnualCoupon.toFixed(2)} ÷ 180) × ${daysAccrued} = ${accruedInterest.toFixed(2)} USD`,
            `5. ${language === 'zh' ? '收到的利息支付 = 半年票息 × 付息次數' : 'Interest Payments Received = Semi-Annual Coupon × Number of Payments'} (${paymentDates.length}) = ${semiAnnualCoupon.toFixed(2)} × ${paymentDates.length} = ${totalInterestReceived.toFixed(2)} USD`,
            `6. ${language === 'zh' ? '淨利息 = 收到的利息 - 應計利息' : 'Net Interest = Total Interest Received - Accrued Interest'} = ${totalInterestReceived.toFixed(2)} - ${accruedInterest.toFixed(2)} = ${netInterest.toFixed(2)} USD`,
            `7. ${language === 'zh' ? '資本利得 = (賣出價格 - 買入價格) × (面值 ÷ 100)' : 'Capital Gain = (Sell Price - Buy Price) × (Face Value ÷ 100)'} = (${sellPriceNum} - ${buyPriceNum}) × (${faceValue.toFixed(2)} ÷ 100) = ${capitalGain.toFixed(2)} USD`,
            `8. ${language === 'zh' ? '總回報 = 淨利息 + 資本利得' : 'Total Return = Net Interest + Capital Gain'} = ${netInterest.toFixed(2)} + ${capitalGain.toFixed(2)} = ${totalReturn.toFixed(2)} USD`,
            `9. ${language === 'zh' ? '回報百分比 = (總回報 ÷ 投資金額) × 100' : 'Return Percentage = (Total Return ÷ Investment Amount) × 100'} = (${totalReturn.toFixed(2)} ÷ ${investmentAmountNum}) × 100 = ${returnPercentage.toFixed(2)}%`
          ];

          // 儲存結果
          const result = {
            faceValue: faceValue.toFixed(2),
            accruedInterest: accruedInterest.toFixed(2),
            netInterest: netInterest.toFixed(2),
            capitalGain: capitalGain.toFixed(2),
            totalReturn: totalReturn.toFixed(2),
            returnPercentage: returnPercentage.toFixed(2),
            hkdReturn,
            steps
          };
          setResults(result);

          // 儲存到歷史記錄
          const newHistory = [...history, { ...result, cusip, buyDate, sellDate, timestamp: new Date().toISOString() }];
          setHistory(newHistory);
          localStorage.setItem('calcHistory', JSON.stringify(newHistory));
        } catch (err) {
          setError(err.message);
          console.error('Calculation Error:', err.message); // 調試日誌
        }
      };

      // 獲取上一個付息日期
      const getLastPaymentDate = (buyDate, paymentDates) => {
        const buyYear = buyDate.getFullYear();
        const dates = paymentDates.map(date => {
          const [month, day] = date.split('-');
          return new Date(buyYear, month - 1, day);
        }).filter(date => date <= buyDate);
        if (dates.length === 0) {
          const issueDate = new Date(cusipData[cusip].issueDate);
          console.log('Using issue date as fallback:', issueDate); // 調試日誌
          return issueDate;
        }
        return dates[dates.length - 1];
      };

      // 獲取買入到賣出之間的付息日期
      const getPaymentDatesBetween = (buyDate, sellDate, paymentDates) => {
        const dates = [];
        let currentYear = buyDate.getFullYear();
        const endYear = sellDate.getFullYear();
        while (currentYear <= endYear) {
          paymentDates.forEach(date => {
            const [month, day] = date.split('-');
            const paymentDate = new Date(currentYear, month - 1, day);
            if (paymentDate > buyDate && paymentDate <= sellDate) {
              dates.push(paymentDate);
            }
          });
          currentYear++;
        }
        return dates;
      };

      // 匯出 CSV
      const exportToCSV = () => {
        if (!results) return;
        const csvContent = [
          `${translations[language].cusip},${translations[language].faceValue},${translations[language].accruedInterest},${translations[language].netInterest},${translations[language].capitalGain},${translations[language].totalReturn},${translations[language].returnPercentage},${translations[language].buyDate},${translations[language].sellDate}${language === 'zh' ? `,${translations[language].hkdReturn}` : ''}`,
          `${cusip},${results.faceValue},${results.accruedInterest},${results.netInterest},${results.capitalGain},${results.totalReturn},${results.returnPercentage}%,${buyDate},${sellDate}${results.hkdReturn ? `,${results.hkdReturn}` : ''}`
        ].join('\n');
        const blob = new Blob([csvContent], { type: 'text/csv' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `bond_calculation_${new Date().toISOString()}.csv`;
        a.click();
        URL.revokeObjectURL(url);
      };

      // 清除歷史記錄
      const clearHistory = () => {
        setHistory([]);
        localStorage.removeItem('calcHistory');
      };

      return (
        <div className="max-w-4xl mx-auto p-6 bg-white rounded-lg shadow-lg">
          <div className="flex justify-between items-center mb-4">
            <h1 className="text-2xl font-bold text-center">{translations[language].title}</h1>
            <button
              onClick={toggleLanguage}
              className="bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-600"
            >
              {translations[language].language}
            </button>
          </div>
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label className="block text-sm font-medium text-gray-700">{translations[language].cusip}</label>
              <input
                type="text"
                value={cusip}
                onChange={(e) => setCusip(e.target.value)}
                placeholder="e.g., 91282CLW9"
                className="mt-1 block w-full p-2 border rounded-md"
              />
              {cusipData[cusip] && (
                <p className="text-sm text-gray-600 mt-1">
                  {language === 'zh' ? '發行日期' : 'Issue Date'}: {cusipData[cusip].issueDate} | 
                  {language === 'zh' ? '到期日期' : 'Maturity Date'}: {cusipData[cusip].maturityDate}
                </p>
              )}
            </div>
            <div>
              <label className="block text-sm font-medium text-gray-700">{translations[language].buyPrice}</label>
              <input
                type="number"
                value={buyPrice}
                onChange={(e) => setBuyPrice(e.target.value)}
                placeholder="e.g., 96.867"
                className="mt-1 block w-full p-2 border rounded-md"
                step="0.001"
              />
            </div>
            <div>
              <label className="block text-sm font-medium text-gray-700">{translations[language].buyDate}</label>
              <input
                type="date"
                value={buyDate}
                onChange={(e) => setBuyDate(e.target.value)}
                className="mt-1 block w-full p-2 border rounded-md"
              />
            </div>
            <div>
              <label className="block text-sm font-medium text-gray-700">{translations[language].investmentAmount}</label>
              <input
                type="number"
                value={investmentAmount}
                onChange={(e) => setInvestmentAmount(e.target.value)}
                placeholder="e.g., 21000"
                className="mt-1 block w-full p-2 border rounded-md"
                step="0.01"
              />
            </div>
            <div>
              <label className="block text-sm font-medium text-gray-700">{translations[language].couponRate}</label>
              <input
                type="number"
                value={couponRate}
                onChange={(e) => setCouponRate(e.target.value)}
                placeholder="e.g., 4.25"
                className="mt-1 block w-full p-2 border rounded-md"
                step="0.01"
                disabled={cusipData[cusip]}
              />
            </div>
            <div>
              <label className="block text-sm font-medium text-gray-700">{translations[language].sellDate}</label>
              <input
                type="date"
                value={sellDate}
                onChange={(e) => setSellDate(e.target.value)}
                className="mt-1 block w-full p-2 border rounded-md"
              />
            </div>
            <div>
              <label className="block text-sm font-medium text-gray-700">{translations[language].sellPrice}</label>
              <input
                type="number"
                value={sellPrice}
                onChange={(e) => setSellPrice(e.target.value)}
                placeholder="e.g., 98.963"
                className="mt-1 block w-full p-2 border rounded-md"
                step="0.001"
              />
            </div>
            <div>
              <label className="block text-sm font-medium text-gray-700">{translations[language].exchangeRate}</label>
              <input
                type="number"
                value={exchangeRate}
                onChange={(e) => setExchangeRate(e.target.value)}
                placeholder="e.g., 7.8"
                className="mt-1 block w-full p-2 border rounded-md"
                step="0.01"
              />
            </div>
          </div>
          {error && <p className="text-red-500 text-center mt-4">{error}</p>}
          <div className="flex justify-center mt-6 space-x-4">
            <button
              onClick={calculateReturns}
              className="bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-600"
            >
              {translations[language].calculate}
            </button>
            {results && (
              <button
                onClick={exportToCSV}
                className="bg-green-500 text-white px-4 py-2 rounded-md hover:bg-green-600"
              >
                {translations[language].exportCSV}
              </button>
            )}
          </div>
          {results && (
            <div className="mt-6 p-4 bg-gray-50 rounded-md">
              <h2 className="text-lg font-semibold">{translations[language].results}</h2>
              <p>{translations[language].faceValue}: ${results.faceValue}</p>
              <p>{translations[language].accruedInterest}: ${results.accruedInterest}</p>
              <p>{translations[language].netInterest}: ${results.netInterest}</p>
              <p>{translations[language].capitalGain}: ${results.capitalGain}</p>
              <p>{translations[language].totalReturn}: ${results.totalReturn}</p>
              <p>{translations[language].returnPercentage}: {results.returnPercentage}%</p>
              {results.hkdReturn && (
                <p>{translations[language].hkdReturn}: HK${results.hkdReturn}</p>
              )}
              <p className="text-sm text-gray-600 mt-2">{translations[language].taxNote}</p>
              <h3 className="mt-4 font-semibold">{translations[language].calculationSteps}</h3>
              <ul className="list-disc pl-5">
                {results.steps.map((step, index) => (
                  <li key={index} className="text-sm">{step}</li>
                ))}
              </ul>
            </div>
          )}
          {history.length > 0 && (
            <div className="mt-6 p-4 bg-gray-50 rounded-md">
              <h2 className="text-lg font-semibold">{translations[language].history}</h2>
              <button
                onClick={clearHistory}
                className="bg-red-500 text-white px-4 py-2 rounded-md hover:bg-red-600 mb-4"
              >
                {translations[language].clearHistory}
              </button>
              <div className="space-y-2">
                {history.map((entry, index) => (
                  <div key={index} className="p-2 bg-white rounded-md shadow">
                    <p>{translations[language].cusip}: {entry.cusip} | {translations[language].date}: {new Date(entry.timestamp).toLocaleString()}</p>
                    <p>{translations[language].faceValue}: ${entry.faceValue} | {translations[language].totalReturn}: ${entry.totalReturn} ({entry.returnPercentage}%)</p>
                    {entry.hkdReturn && <p>{translations[language].hkdReturn}: HK${entry.hkdReturn}</p>}
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      );
    };

    // 渲染應用
    try {
      ReactDOM.render(<BondCalculator />, document.getElementById('root'));
    } catch (err) {
      console.error('Render Error:', err.message);
    }
  </script>
</body>
</html>
